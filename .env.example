# Set at least one key. Copy this file to .env and fill it in.

# Google Gemini - free tier is enough for testing.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Anthropic Claude - paid, pay-as-you-go.
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optional
# LLM_PROVIDER=gemini
# COMPANY_NAME=Larkspur Cycles
# SUPPORT_CONTACT=support@larkspur.example
# KB_DIR=kb
# ALLOWED_ORIGINS=https://yoursite.com
